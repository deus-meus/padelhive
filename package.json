{
  "name": "padelhive",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @padelhive/web dev",
    "build": "bun --filter @padelhive/web build && bun --filter @padelhive/api build",
    "lint": "bun --filter @padelhive/web lint && bun --filter @padelhive/api lint",
    "api:dev": "bun --filter @padelhive/api start:dev",
    "api:build": "bun --filter @padelhive/api build",
    "api:lint": "bun --filter @padelhive/api lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:validate": "bun --filter @padelhive/api prisma:validate",
    "prisma:generate": "bun --filter @padelhive/api prisma:generate",
    "prisma:migrate": "bun --filter @padelhive/api prisma:migrate:dev",
    "prisma:seed": "bun --filter @padelhive/api prisma:seed",
    "backend:setup": "bun run prisma:generate && bun run prisma:migrate && bun run prisma:seed"
  }
}
