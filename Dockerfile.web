FROM oven/bun:1-alpine AS builder

WORKDIR /app
RUN apk add --no-cache openssl

# Set environment variables for build time
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MIDTRANS_CLIENT_KEY
ARG NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=${NEXT_PUBLIC_MIDTRANS_CLIENT_KEY}
ENV NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=${NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION}

# Copy package files and bun lockfile
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the Web frontend
RUN bun --filter @padelhive/web build

# Production image
FROM oven/bun:1-alpine AS runner

WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder
RUN mkdir -p /app/apps/web/public
COPY --from=builder /app/apps/web/public* ./apps/web/public/
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# IMPORTANT: Setting HOSTNAME to 0.0.0.0 ensures server listens on all interfaces
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

# Fix for Next.js 14+ Server Actions issue in standalone mode:
# Ensuring execution happens from the right working directory where the standalone bundle lives
WORKDIR /app/apps/web

USER nextjs

EXPOSE 3000

# Start the standalone server with Bun
CMD ["bun", "server.js"]
