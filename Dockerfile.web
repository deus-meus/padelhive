FROM oven/bun:1-alpine AS builder

WORKDIR /app
RUN apk add --no-cache openssl

# Set environment variables for build time
ARG PUBLIC_API_URL
ARG VITE_API_URL
ARG PUBLIC_FIREBASE_API_KEY
ARG VITE_FIREBASE_API_KEY
ARG PUBLIC_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG PUBLIC_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_PROJECT_ID
ARG PUBLIC_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG PUBLIC_FIREBASE_APP_ID
ARG VITE_FIREBASE_APP_ID

ENV PUBLIC_API_URL=${PUBLIC_API_URL:-${VITE_API_URL}}
ENV VITE_API_URL=${VITE_API_URL:-${PUBLIC_API_URL}}
ENV PUBLIC_FIREBASE_API_KEY=${PUBLIC_FIREBASE_API_KEY:-${VITE_FIREBASE_API_KEY}}
ENV VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY:-${PUBLIC_FIREBASE_API_KEY}}
ENV PUBLIC_FIREBASE_AUTH_DOMAIN=${PUBLIC_FIREBASE_AUTH_DOMAIN:-${VITE_FIREBASE_AUTH_DOMAIN}}
ENV VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN:-${PUBLIC_FIREBASE_AUTH_DOMAIN}}
ENV PUBLIC_FIREBASE_PROJECT_ID=${PUBLIC_FIREBASE_PROJECT_ID:-${VITE_FIREBASE_PROJECT_ID}}
ENV VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID:-${PUBLIC_FIREBASE_PROJECT_ID}}
ENV PUBLIC_FIREBASE_STORAGE_BUCKET=${PUBLIC_FIREBASE_STORAGE_BUCKET:-${VITE_FIREBASE_STORAGE_BUCKET}}
ENV VITE_FIREBASE_STORAGE_BUCKET=${VITE_FIREBASE_STORAGE_BUCKET:-${PUBLIC_FIREBASE_STORAGE_BUCKET}}
ENV PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${PUBLIC_FIREBASE_MESSAGING_SENDER_ID:-${VITE_FIREBASE_MESSAGING_SENDER_ID}}
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=${VITE_FIREBASE_MESSAGING_SENDER_ID:-${PUBLIC_FIREBASE_MESSAGING_SENDER_ID}}
ENV PUBLIC_FIREBASE_APP_ID=${PUBLIC_FIREBASE_APP_ID:-${VITE_FIREBASE_APP_ID}}
ENV VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID:-${PUBLIC_FIREBASE_APP_ID}}

# Copy package files and bun lockfile
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the Web frontend
RUN bun --filter @padelhive/web build

# Production image
FROM oven/bun:1-alpine AS runner

WORKDIR /app

ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 sveltejs

# Copy built adapter-node output from builder
COPY --from=builder /app/apps/web/build ./apps/web/build
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

WORKDIR /app/apps/web

USER sveltejs

EXPOSE 3000

# Start SvelteKit standalone Node server via Bun
CMD ["bun", "build/index.js"]
