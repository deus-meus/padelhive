FROM oven/bun:1-alpine AS builder

WORKDIR /app
RUN apk add --no-cache openssl

# Set environment variables for build time
ARG PUBLIC_API_URL
ARG PUBLIC_FIREBASE_API_KEY
ARG PUBLIC_FIREBASE_AUTH_DOMAIN
ARG PUBLIC_FIREBASE_PROJECT_ID
ARG PUBLIC_FIREBASE_STORAGE_BUCKET
ARG PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG PUBLIC_FIREBASE_APP_ID
ARG PUBLIC_MIDTRANS_CLIENT_KEY

ENV PUBLIC_API_URL=${PUBLIC_API_URL}
ENV PUBLIC_FIREBASE_API_KEY=${PUBLIC_FIREBASE_API_KEY}
ENV PUBLIC_FIREBASE_AUTH_DOMAIN=${PUBLIC_FIREBASE_AUTH_DOMAIN}
ENV PUBLIC_FIREBASE_PROJECT_ID=${PUBLIC_FIREBASE_PROJECT_ID}
ENV PUBLIC_FIREBASE_STORAGE_BUCKET=${PUBLIC_FIREBASE_STORAGE_BUCKET}
ENV PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${PUBLIC_FIREBASE_MESSAGING_SENDER_ID}
ENV PUBLIC_FIREBASE_APP_ID=${PUBLIC_FIREBASE_APP_ID}
ENV PUBLIC_MIDTRANS_CLIENT_KEY=${PUBLIC_MIDTRANS_CLIENT_KEY}

# Copy package files and bun lockfile
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the Web frontend
RUN bun --filter @padelhive/web build

# Production image
FROM oven/bun:1-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 sveltejs

# Copy monorepo package files and built artifacts
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY --from=builder /app/apps/web/build ./apps/web/build

# Install dependencies in production runner stage
RUN bun install --frozen-lockfile

# Set correct ownership for sveltejs user
RUN chown -R sveltejs:nodejs /app

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

USER sveltejs

EXPOSE 3000

# Start SvelteKit standalone Node server via Bun from root /app
CMD ["bun", "apps/web/build/index.js"]
