{
  "name": "@padelhive/api",
  "version": "0.1.0",
  "private": true,
  "description": "Padelhive ElysiaJS backend",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "start:dev": "bun --watch src/index.ts",
    "lint": "bun biome check .",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:create": "prisma migrate dev --create-only --schema prisma/schema.prisma",
    "prisma:seed": "bun prisma/seed.ts",
    "test": "bun test",
    "test:int": "bun test test/integration"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.11.1",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^20.17.9",
    "@types/supertest": "^7.2.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  }
}
