{
  "name": "@padelhive/api",
  "version": "0.1.0",
  "private": true,
  "description": "Padelhive ElysiaJS backend",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "start:dev": "bun --watch src/index.ts",
    "lint": "bun biome check .",
    "prisma:validate": "../../node_modules/.bin/prisma validate --schema prisma/schema.prisma || prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "../../node_modules/.bin/prisma generate --schema prisma/schema.prisma || prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "../../node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma || prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "../../node_modules/.bin/prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:create": "../../node_modules/.bin/prisma migrate dev --create-only --schema prisma/schema.prisma",
    "prisma:seed": "bun prisma/seed.ts",
    "test": "jest --runInBand --forceExit",
    "test:int": "jest --config ./jest-int.config.js --runInBand"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.11.1",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(test|spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  }
}
