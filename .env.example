# ==============================================================================
# PADELHIVE PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# DOCKER REPOSITORY
GH_OWNER=deus-meus

# DATABASE
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=padelhive
# DATABASE_URL is constructed automatically in docker-compose.prod.yml
# REDIS_URL is constructed automatically in docker-compose.prod.yml

# SECURITY & AUTH (Used by NestJS)
# Get from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
# Ensure PRIVATE_KEY is enclosed in quotes and line breaks are preserved (or use \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIB...your_key_here...\n-----END PRIVATE KEY-----\n"

# PAYMENTS (Midtrans)
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_IS_PRODUCTION=false

# EMAIL (Resend)
MAIL_ENABLED=true
MAIL_FROM=noreply@padelhive.com
RESEND_API_KEY=re_...
APP_WEB_URL=http://your-server-ip:3000

# NEXT.JS FRONTEND (Injected at build time in CI/CD)
# Note: For Docker deployment, these need to be passed during `docker build` in GitHub Actions
# NEXT_PUBLIC_API_URL=http://your-server-ip:3001/api
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-...
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
