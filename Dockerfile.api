FROM oven/bun:1-alpine AS builder

WORKDIR /app
RUN apk add --no-cache openssl

# Copy monorepo package files and bun lockfile
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Generate Prisma Client and build the API
RUN bun --filter @padelhive/api prisma:generate
RUN bun --filter @padelhive/api build

# Create production image
FROM oven/bun:1-alpine

WORKDIR /app
RUN apk add --no-cache openssl

# Copy monorepo package files and built artifacts
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/tsconfig.json ./apps/api/tsconfig.json

# Install dependencies in production container and generate Prisma Client
RUN bun install --frozen-lockfile
RUN bun --filter @padelhive/api prisma:generate

# Entrypoint script for migrations, seeding, and starting
COPY apps/api/entrypoint.sh /app/apps/api/entrypoint.sh
RUN chmod +x /app/apps/api/entrypoint.sh

ENV NODE_ENV=production
ENV PRISMA_GENERATE_SKIP_AUTO_INSTALL=true

EXPOSE 3001
ENTRYPOINT ["/app/apps/api/entrypoint.sh"]
